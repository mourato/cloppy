#!/usr/bin/env bash
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-merge "$@" || exit $?

# Shared agent-config finalizer, adapted for Git LFS and Cloppy Scripts/.
set -eu

[[ ${AGENT_CONFIG_FINISH_TASK:-0} == 1 ]] && exit 0

branch=$(git branch --show-current 2>/dev/null || true)
case "$branch" in
  main|master) ;;
  *) exit 0 ;;
esac

repo=$(git rev-parse --show-toplevel)
shim="$repo/Scripts/cleanup-merged-worktrees.sh"
[[ -f $shim ]] || {
  printf 'post-merge: missing cleanup helper: %s\n' "$shim" >&2
  exit 1
}

printf 'post-merge: MERGED branch=%s; pushing, then cleaning merged worktrees\n' "$branch"

if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_INDEX_FILE \
  -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
  git -C "$repo" push; then
  printf 'post-merge: PUSH failed; CLEANUP skipped\n' >&2
  exit 1
fi

printf 'post-merge: PUSHED branch=%s; cleanup starting\n' "$branch"

if ! bash "$shim" --apply; then
  printf 'post-merge: CLEANUP failed after PUSHED\n' >&2
  exit 1
fi

printf 'post-merge: CLEANED complete\n'
